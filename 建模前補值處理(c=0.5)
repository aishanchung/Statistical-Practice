  as.character(DBI::dbQuoteString(con, x))
}

qi <- function(x) {
  as.character(DBI::dbQuoteIdentifier(con, x))
}

DBI::dbExecute(con, "SET threads = 4")
DBI::dbExecute(con, "SET memory_limit = '4GB'")

DBI::dbExecute(
