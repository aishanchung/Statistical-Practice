required <- c("BottleneckTime", stations)

if (!all(required %in% schema$column_name)) {
  stop(
    "缺少欄位：",
    paste(
      setdiff(required, schema$column_name),
      collapse = ", "
    )
  )
}

new_names <- unlist(lapply(stations, function(s) {
  c(
    paste0(s, "_Filled"),
