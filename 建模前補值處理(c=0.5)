library(data.table)

required_objects <- c(
  "output_path", "output_dir", "lookup", "bin_expr"
)

if (!all(vapply(required_objects, exists, logical(1)))) {
  stop("缺少上一階段物件，請在剛才補值使用的 R 工作階段執行。")
}

if (!file.exists(output_path)) {
