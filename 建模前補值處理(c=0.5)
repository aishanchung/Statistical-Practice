  grid,
  panel,
  by = "TimeBin",
  all.x = TRUE,
  sort = TRUE
)

panel[is.na(HasTripRecord), HasTripRecord := FALSE]

speed_cols <- paste0("s", 1:5)

raw <- as.matrix(panel[, ..speed_cols])
storage.mode(raw) <- "double"

# ------------------------------------------------------------
# 5. 判定有效值與補值對象
# ------------------------------------------------------------

has_trip_matrix <- matrix(
  panel$HasTripRecord,
  nrow = nrow(raw),
  ncol = ncol(raw)
)

is_missing_code <- matrix(
  raw %in% MISSING_CODES,
  nrow = nrow(raw),
  ncol = ncol(raw)
)

valid <- is.finite(raw) & raw >= 0

observed <- raw
observed[!valid] <- NA_real_

target_missing <- (
  is.na(raw) | is_missing_code
) & has_trip_matrix

filled <- raw
filled[is.na(raw) | is_missing_code] <- NA_real_

method <- matrix(
  "INVALID_NOT_FILLED",
  nrow = nrow(raw),
  ncol = ncol(raw)
)

method[valid] <- "OBSERVED"
method[!is.na(raw) & raw == -1] <- "NO_VEHICLE_MINUS1"
method[target_missing] <- "UNFILLED"
method[!has_trip_matrix] <- "NO_TRIP_RECORD"

gap_minutes <- matrix(
  0L,
  nrow = nrow(raw),
  ncol = ncol(raw)
)

year <- as.integer(
  format(panel$TimeBin, "%Y", tz = "UTC")
)

# ------------------------------------------------------------
# 6. 短缺口線性插值
# 不跨年度、不使用補值當作插值端點
# ------------------------------------------------------------

for (j in 1:5) {
  
  runs <- rle(!valid[, j])
  ends <- cumsum(runs$lengths)
  starts <- ends - runs$lengths + 1L
  
  for (r in which(runs$values)) {
    
    a <- starts[r]
    b <- ends[r]
    
    gap_minutes[a:b, j] <- runs$lengths[r] * 5L
    
    left <- a - 1L
    right <- b + 1L
    
    if (
      runs$lengths[r] * 5L > SHORT_GAP_MIN ||
      left < 1L ||
      right > nrow(panel)
    ) next
    
    if (!valid[left, j] || !valid[right, j]) next
    if (year[left] != year[right]) next
    
    idx <- (a:b)[target_missing[a:b, j]]
    
    if (!length(idx)) next
    
    filled[idx, j] <- observed[left, j] +
      (observed[right, j] - observed[left, j]) *
      (idx - left) / (right - left)
    
    method[idx, j] <- "LINEAR_SHORT"
  }
}

# ------------------------------------------------------------
# 7. KNN 的時間特徵
# 沿用網站：時刻、星期、週末、年內週期
# ------------------------------------------------------------

lt <- as.POSIXlt(panel$TimeBin, tz = "UTC")

slot <- lt$hour * 12 + lt$min / 5
dow <- (lt$wday + 6) %% 7
doy <- lt$yday + 1

tod_angle <- 2 * pi * slot / 288
week_angle <- 2 * pi * dow / 7
year_angle <- 2 * pi * doy / 365.25

calendar_x <- cbind(
  sin(tod_angle) * 1.5,
  cos(tod_angle) * 1.5,
  sin(2 * tod_angle) * 0.65,
  cos(2 * tod_angle) * 0.65,
  sin(week_angle) * 0.70,
  cos(week_angle) * 0.70,
  as.numeric(dow >= 5) * 0.65,
  sin(year_angle) * 0.35,
  cos(year_angle) * 0.35
)

train_2024 <- year == 2024

knn_log <- list()
log_id <- 0L

# ------------------------------------------------------------
# 8. 歷史相似 KNN
#
# 根據當下實際有效的其他測站組合分開搜尋
# 歷史庫只用 2024 原始有效觀測
# 不把其他站補出的速度拿來當輸入
# ------------------------------------------------------------

for (j in 1:5) {
  
  donors <- setdiff(1:5, j)
  
  pattern <- as.integer(
    valid[, donors, drop = FALSE] %*% (2^(0:3))
  )
  
  pending <- target_missing[, j] &
    method[, j] == "UNFILLED"
  
  method[
    pending & pattern == 0L, j
  ] <- "UNFILLED_NO_DONOR"
  
  patterns_to_run <- sort(
    unique(pattern[pending & pattern > 0L])
  )
  
  for (p in patterns_to_run) {
    
    donor_set <- donors[
      bitwAnd(
        as.integer(p),
        as.integer(2^(0:3))
      ) != 0L
    ]
    
    query_idx <- which(pending & pattern == p)
    
    train_ok <- train_2024 &
      valid[, j] &
      rowSums(
        valid[, donor_set, drop = FALSE]
      ) == length(donor_set)
    
    train_idx <- which(train_ok)
    
    if (length(train_idx) < MIN_DONORS) {
      method[
        query_idx, j
      ] <- "UNFILLED_TOO_FEW_DONORS"
      
      next
    }
    
    if (length(train_idx) > MAX_DONORS) {
      keep <- unique(round(
        seq(
          1,
          length(train_idx),
          length.out = MAX_DONORS
        )
      ))
      
      train_idx <- train_idx[keep]
    }
    
    train_x <- cbind(
      calendar_x[train_idx, , drop = FALSE],
      observed[train_idx, donor_set, drop = FALSE] / 15
    )
    
    k <- min(K_NEIGHBORS, length(train_idx))
    
    batches <- split(
      query_idx,
      ceiling(seq_along(query_idx) / 5000)
    )
    
    for (idx in batches) {
      
      query_x <- cbind(
        calendar_x[idx, , drop = FALSE],
        observed[idx, donor_set, drop = FALSE] / 15
      )
      
      nn <- RANN::nn2(
        data = train_x,
        query = query_x,
        k = k,
        eps = 0
      )
      
      neighbor_y <- matrix(
        observed[train_idx, j][as.vector(nn$nn.idx)],
        nrow = length(idx),
        ncol = k
      )
      
      neighbor_weights <- 1 / pmax(
        nn$nn.dists, 0.05
      )
      
      filled[idx, j] <- rowSums(
        neighbor_weights * neighbor_y
      ) / rowSums(neighbor_weights)
      
      method[idx, j] <- "KNN_2024"
    }
    
    log_id <- log_id + 1L
    
    knn_log[[log_id]] <- data.table(
      TargetStation = stations[j],
      DonorStations = paste(
        stations[donor_set],
        collapse = ";"
      ),
      TrainingRows = length(train_idx),
      ImputedBins = length(query_idx),
      K = k
    )
  }
  
  cat("完成補值：", stations[j], "\n")
}

