# 11. 接回原始旅次資料
# 原始欄位不動，只新增每站三個欄位
# ------------------------------------------------------------

added <- unlist(lapply(stations, function(s) {
  
  orig <- paste0("k.", qi(s))
  
  missing_expr <- paste0(
    "(",
    orig, " IS NULL",
    " OR isnan(", orig, ")",
    " OR ", orig, " IN (-99, -999, -9999)",
    ")"
  )
  
  f <- qi(paste0(s, "_Filled"))
  m <- qi(paste0(s, "_ImputationMethod"))
  g <- qi(paste0(s, "_GapMinutes"))
  
  c(
    paste0(
      "CASE WHEN ", missing_expr,
      " THEN p.", f,
      " ELSE ", orig,
      " END AS ", f
    ),
    
    paste0(
      "CASE WHEN ", missing_expr,
      " THEN CASE",
      " WHEN p.", m, " = 'OBSERVED'",
      " THEN 'SAME_BIN_OBSERVED'",
      " ELSE p.", m, " END",
      " WHEN ", orig, " = -1",
      " THEN 'NO_VEHICLE_MINUS1'",
      " WHEN ", orig, " >= 0",
      " AND isfinite(", orig, ")",
      " THEN 'OBSERVED'",
      " ELSE 'INVALID_NOT_FILLED'",
      " END AS ", m
    ),
    
    paste0("p.", g, " AS ", g)
  )
}))

