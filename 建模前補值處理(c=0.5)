}

C_MAIN <- 0.50  # 暫定，尚待敏感性分析

weights <- c(
  VD_69p510_Speed = 0.0417,
  VD_65p990_Speed = 0.4600,
  VD_63p990_Speed = 0.3600,
  VD_61p670_Speed = 0.1383
)

stopifnot(abs(sum(weights) - 1) < 1e-10)

site_names <- names(weights)
filled_names <- paste0(site_names, "_Filled")
method_names <- paste0(site_names, "_ImputationMethod")

stopifnot(all(
  c("__vd_key", filled_names, method_names) %in% names(lookup)
))

# lookup 每個 VD 時段只有一列
if (anyDuplicated(lookup[["__vd_key"]])) {
  stop("VD 補值表時間鍵重複，停止，避免接回時增加旅次列數。")
}

# ------------------------------------------------------------
# 1. 取出四站補值後速度
# -1、其他負數、NA、Inf 都不當作有效速度
# ------------------------------------------------------------

speed <- as.matrix(lookup[, ..filled_names])
storage.mode(speed) <- "double"

valid <- is.finite(speed) & speed >= 0

method_matrix <- as.matrix(lookup[, ..method_names])

# 只有實際採用補值且速度有效，才算補值站
is_imputed <- valid &
  method_matrix %in% c("LINEAR_SHORT", "KNN_2024")

# 確保維度一致
dim(is_imputed) <- dim(valid)

valid_weight <- sweep(valid * 1, 2, weights, "*")

# 無效值先歸零，只供分子加總；分母仍僅計有效站
station_congested <- matrix(
  FALSE,
  nrow = nrow(speed),
  ncol = ncol(speed)
)
station_congested[valid] <- speed[valid] < 40

congested_weight <- sweep(
  station_congested * 1, 2, weights, "*"
)

coverage <- rowSums(valid_weight)
numerator <- rowSums(congested_weight)

C_weighted <- rep(NA_real_, nrow(speed))
has_information <- coverage > 0

C_weighted[has_information] <-
  numerator[has_information] / coverage[has_information]

# 避免浮點誤差使理論上的 1 略超過 1
C_weighted[has_information] <- pmin(
  1, pmax(0, C_weighted[has_information])
)

make_Y <- function(C, threshold) {
  result <- rep(NA_integer_, length(C))
  ok <- is.finite(C)
  
  result[ok & C == 0] <- 0L
  result[ok & C > 0 & C < threshold] <- 1L
  result[ok & C >= threshold] <- 2L
  
  result
}

# ------------------------------------------------------------
# 2. 建立主 Y、敏感性分析 Y 與資料品質欄位
# ------------------------------------------------------------

y_table <- data.table(
  VDTimeKey = lookup[["__vd_key"]],
  C_weighted = C_weighted,
  Y = make_Y(C_weighted, C_MAIN),
  Y_c025 = make_Y(C_weighted, 0.25),
  Y_c075 = make_Y(C_weighted, 0.75),
  n_valid_vd = as.integer(rowSums(valid)),
  n_missing_vd = as.integer(4L - rowSums(valid)),
  weight_coverage = coverage,
  used_partial_vd = rowSums(valid) > 0 & rowSums(valid) < 4,
  n_imputed_vd = as.integer(rowSums(is_imputed))
)

y_table[, Y_used_imputation := n_imputed_vd > 0]

y_table[, Y_source := fifelse(
  n_valid_vd == 0L,
  "UNKNOWN",
  fifelse(
    Y_used_imputation,
    "USES_IMPUTED_SPEED",
    "OBSERVED_SPEED_ONLY"
  )
)]

y_table[, Y_label := fcase(
  Y == 0L, "無壅塞",
  Y == 1L, "局部壅塞",
  Y == 2L, "大範圍壅塞",
  default = "無法判定"
)]

# ------------------------------------------------------------
# 3. 摘要：每個 VD 時段一筆，不按旅次重複計算
# ------------------------------------------------------------

y_summary <- y_table[
  ,
  .(TimeBins = .N),
  by = .(Y, Y_label, Y_source)
