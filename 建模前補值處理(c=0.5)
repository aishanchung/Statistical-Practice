}

# ------------------------------------------------------------
# 3. VD 配對時間
#
# 原始鐘面值視為臺灣時間，不另外加 8 小時。
# 恰好整 5 分鐘的時間歸前一個 VD 區間。
# ------------------------------------------------------------

time_type <- schema$column_type[
  schema$column_name == "BottleneckTime"
]

stopifnot(length(time_type) == 1L)

clock_source <- if (
  grepl("WITH TIME ZONE|TIMESTAMPTZ", time_type)
) {
  "timezone('UTC', BottleneckTime)"
} else {
  "BottleneckTime"
}

# 保留小數秒，避免 00:15:00.500 被誤認為整分鐘邊界
clock_expr <- paste0(
  "TRY_CAST(regexp_replace(",
  "REPLACE(CAST(", clock_source, " AS VARCHAR), 'T', ' '), ",
  "'(Z|[+-][0-9]{2}(:?[0-9]{2})?)$', '') AS TIMESTAMP)"
)

floor_expr <- paste0(
  "time_bucket(INTERVAL '5 minutes', ",
  clock_expr, ")"
)

bin_expr <- paste0(
  "CASE WHEN ", clock_expr, " = ", floor_expr,
  " THEN ", floor_expr, " - INTERVAL '5 minutes'",
  " ELSE ", floor_expr, " END"
)

DBI::dbExecute(
  con,
  paste0(
    "CREATE VIEW keyed AS SELECT *, ",
    bin_expr, " AS __vd_bin FROM src"
  )
)

time_check <- DBI::dbGetQuery(
  con,
  "SELECT
     MIN(__vd_bin) AS FirstTime,
     MAX(__vd_bin) AS LastTime,
     COUNT(*) AS TripRows,
     COUNT(*) FILTER (
       WHERE __vd_bin IS NULL
     ) AS UnparsedRows
   FROM keyed"
)

cat("\n【時間檢查】\n")
print(time_check)

if (time_check$UnparsedRows > 0) {
  stop("有無法解析的時間，停止處理。")
}

# ------------------------------------------------------------
# 4. 每時段每站整理為一筆
# ------------------------------------------------------------

select_parts <- unlist(
  lapply(seq_along(stations), function(j) {
    s <- qi(stations[j])
    
    c(
      paste0("MAX(", s, ") AS s", j),
      paste0("COUNT(DISTINCT ", s, ") AS n", j)
    )
  })
)

panel <- as.data.table(
  DBI::dbGetQuery(
    con,
    paste0(
      "SELECT __vd_bin AS TimeBin, ",
      paste(select_parts, collapse = ", "),
      " FROM keyed",
      " GROUP BY __vd_bin",
      " ORDER BY __vd_bin"
    )
