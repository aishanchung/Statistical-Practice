sites <- c(
  "VD_69p510_Speed",
  "VD_65p990_Speed",
  "VD_63p990_Speed",
  "VD_61p670_Speed"
)

w <- c(0.0417, 0.4600, 0.3600, 0.1383)

speed_cols <- paste0(sites, "_Filled")
method_cols <- paste0(sites, "_ImputationMethod")

v <- as.matrix(lookup[, ..speed_cols])
m <- as.matrix(lookup[, ..method_cols])

valid_station <- is.finite(v) & v >= 0

# 檢查 c 時只用四站都有原始有效觀測的時段
all_observed <- rowSums(valid_station) == 4L &
  rowSums(m == "OBSERVED") == 4L

time_text <- lookup[["__vd_key"]]
is_2024 <- substr(time_text, 1, 4) == "2024"

idx <- which(all_observed & is_2024)

if (!length(idx)) {
  stop("沒有符合條件的 2024 四站完整原始觀測。")
}

congested <- v[idx, , drop = FALSE] < 40

patterns <- data.table(
  CongestedStations = apply(
    congested,
    1,
    function(z) {
      if (!any(z)) return("無")
      paste(
        c("69.510", "65.990", "63.990", "61.670")[z],
        collapse = "+"
      )
    }
  ),
  C = as.numeric(congested %*% w)
)

pattern_summary <- patterns[
  ,
  .(TimeBins = .N),
  by = .(CongestedStations, C)
][order(C)]

