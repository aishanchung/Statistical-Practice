make_features <- function(train_end, valid_end, run_name) {
  
  train_end <- as.Date(train_end)
  valid_end <- as.Date(valid_end)
  
  columns <- unique(c(
    "TimeKey", "Date", "Y", "TotalTrips",
    base_features
  ))
  
  d <- copy(base_data[Date <= valid_end, ..columns])
  
  ranking <- pair_counts[
    Date <= train_end &
      DayType %in% c("WEEKEND", "LONGHOLIDAY") &
      !is.na(GantryO) &
      !is.na(GantryD),
    .(TrainTrips = sum(Trips)),
    by = .(PairID, GantryO, GantryD)
  ][TrainTrips >= 100][order(-TrainTrips, PairID)]
  
  if (nrow(ranking) < 50L) {
    stop(run_name, "：符合門檻的 OD 不足 50 組。")
  }
  
  od_map <- copy(ranking[1:50])
  od_map[, Feature := sprintf("OD_%03d", seq_len(.N))]
  
  fwrite(
    od_map,
    file.path(model_dir, paste0(run_name, "_OD_mapping.csv"))
  )
  
  counts <- merge(
    pair_counts[
      Date <= valid_end,
      .(TimeKey, PairID, Trips)
    ],
    od_map[, .(PairID, Feature)],
    by = "PairID"
  )
  
  counts <- counts[TimeKey %in% d$TimeKey]
  
  wide <- dcast(
    counts,
    TimeKey ~ Feature,
    value.var = "Trips",
    fun.aggregate = sum,
    fill = 0
  )
  
  d <- merge(
    d, wide, by = "TimeKey",
    all.x = TRUE, sort = FALSE
  )
  
  for (f in od_map$Feature) {
    if (!f %in% names(d)) d[, (f) := 0]
    set(d, which(is.na(d[[f]])), f, 0)
  }
  
  sets <- list(
    B0 = base_features,
    B1 = c(base_features, "TotalTrips")
  )
  
  for (k in c(10L, 30L, 50L)) {
    
    fs <- od_map$Feature[seq_len(k)]
    other <- paste0("OTHER_", k)
    
    d[
      ,
      (other) := TotalTrips - rowSums(as.matrix(.SD)),
      .SDcols = fs
    ]
    
    stopifnot(all(d[[other]] >= 0))
    
    sets[[paste0("OD", k)]] <- c(
      base_features, fs, other
    )
  }
  
  setorder(d, TimeKey)
  
  list(data = d, sets = sets)
}

# ------------------------------------------------------------
# 4. 評估函數
# ------------------------------------------------------------

evaluate_model <- function(y, probability) {
  
  prediction <- max.col(
    probability, ties.method = "first"
  ) - 1L
  
  cm <- table(
    Actual = factor(y, levels = 0:2),
    Predicted = factor(prediction, levels = 0:2)
  )
  
  tp <- as.numeric(diag(cm))
  actual <- as.numeric(rowSums(cm))
  predicted <- as.numeric(colSums(cm))
  
  precision <- ifelse(predicted > 0, tp / predicted, 0)
  recall <- ifelse(actual > 0, tp / actual, 0)
  
  f1 <- ifelse(
    precision + recall > 0,
    2 * precision * recall / (precision + recall),
    0
  )
  
  # Y=2 的 Average Precision，按同分機率分組
  ap_data <- data.table(
    Score = probability[, 3],
    Positive = as.integer(y == 2L)
  )[
    ,
    .(N = .N, Positives = sum(Positive)),
    by = Score
  ][order(-Score)]
  
  ap_data[, `:=`(
    CumN = cumsum(N),
    CumPositive = cumsum(Positives)
  )]
  
  ap2 <- sum(
    ap_data$Positives *
      ap_data$CumPositive / ap_data$CumN
  ) / sum(y == 2L)
  
  list(
    metrics = data.table(
      MacroF1 = mean(f1),
      AP2 = ap2,
      Precision2 = precision[3],
      Recall2 = recall[3],
      Accuracy = mean(prediction == y),
      LogLoss = -mean(log(pmax(
        probability[cbind(seq_along(y), y + 1L)],
        1e-15
      )))
    ),
    classes = data.table(
      Y = 0:2,
      ActualBins = actual,
      PredictedBins = predicted,
      TP = tp,
      FP = predicted - tp,
      FN = actual - tp,
      Precision = precision,
      Recall = recall,
      F1 = f1
    )
  )
}

# ------------------------------------------------------------
# 5. 單次訓練函數
# 每個模型完成後保存模型與結果
# ------------------------------------------------------------

train_one <- function(
    bundle, train_end, valid_start, valid_end,
    run_name, model_name, grid_id, scheme) {
  
  checkpoint_name <- paste(
    run_name, model_name, scheme, grid_id, sep = "_"
  )
  
  result_path <- file.path(
    model_dir, paste0(checkpoint_name, ".rds")
  )
  
  if (file.exists(result_path)) {
    return(readRDS(result_path))
  }
  
  d <- bundle$data
  fs <- bundle$sets[[model_name]]
  
  tr <- which(d$Date <= as.Date(train_end))
  
  va <- which(
    d$Date >= as.Date(valid_start) &
      d$Date <= as.Date(valid_end)
  )
  
  y_tr <- as.integer(d$Y[tr])
  y_va <- as.integer(d$Y[va])
  
  n_tr <- tabulate(y_tr + 1L, nbins = 3L)
  n_va <- tabulate(y_va + 1L, nbins = 3L)
  
  if (any(n_tr == 0L) || any(n_va == 0L)) {
    stop(checkpoint_name, "：訓練或驗證缺少某類 Y。")
  }
  
  balanced <- length(y_tr) / (3 * n_tr)
  
  class_weight <- switch(
    scheme,
    Unweighted = rep(1, 3),
    SqrtBalanced = sqrt(balanced),
    Balanced = balanced
  )
  
  row_weight <- class_weight[y_tr + 1L]
  row_weight <- row_weight / mean(row_weight)
  
  x <- as.matrix(d[, ..fs])
  storage.mode(x) <- "double"
  x[!is.finite(x)] <- NA_real_
  
  setting <- parameter_grid[grid_id]
  
  dtrain <- lightgbm::lgb.Dataset(
    x[tr, , drop = FALSE],
    label = y_tr,
    weight = row_weight
  )
  
  dvalid <- lightgbm::lgb.Dataset(
    x[va, , drop = FALSE],
    label = y_va,
    reference = dtrain
  )
  
  params <- list(
    objective = "multiclass",
    num_class = 3L,
    metric = "multi_logloss",
    learning_rate = setting$LearningRate,
    num_leaves = setting$NumLeaves,
    min_data_in_leaf = setting$MinDataInLeaf,
    lambda_l2 = 1,
    feature_fraction = 1,
    num_threads = 4L,
    verbosity = -1L,
    seed = 20261104L,
    deterministic = TRUE,
    force_col_wise = TRUE
  )
  
  fit <- lightgbm::lgb.train(
    params = params,
    data = dtrain,
    nrounds = 1500L,
    valids = list(validation = dvalid),
    early_stopping_rounds = 60L,
    verbose = -1L
  )
  
  probability <- predict(
    fit,
    x[va, , drop = FALSE],
    num_iteration = fit$best_iter
  )
  
  stopifnot(
    is.matrix(probability),
    nrow(probability) == length(va),
    ncol(probability) == 3L
  )
  
  ev <- evaluate_model(y_va, probability)
  
  metadata <- data.table(
    Fold = run_name,
    Model = model_name,
    Scheme = scheme,
    GridID = grid_id,
    Features = length(fs),
    BestIteration = fit$best_iter
  )
  
  result <- list(
    record = cbind(metadata, setting, ev$metrics),
    classes = cbind(
      metadata[, .(Fold, Model, Scheme, GridID)],
      ev$classes
    )
  )
  
  lightgbm::lgb.save(
    fit,
    file.path(model_dir, paste0(checkpoint_name, ".txt"))
  )
  
  saveRDS(result, result_path)
  
  cat(
    checkpoint_name,
    "：Macro-F1 =", round(ev$metrics$MacroF1, 4),
    "\n"
  )
  
  result
}

run_grid <- function(
    bundle, train_end, valid_start, valid_end,
    run_name, scheme) {
  
  result_list <- list()
  i <- 0L
  
  for (mn in names(bundle$sets)) {
    for (g in seq_len(nrow(parameter_grid))) {
      
      i <- i + 1L
      
      result_list[[i]] <- train_one(
        bundle,
        train_end, valid_start, valid_end,
        run_name, mn, g, scheme
      )
    }
  }
  
  list(
    records = rbindlist(
      lapply(result_list, function(z) z$record)
    ),
    classes = rbindlist(
      lapply(result_list, function(z) z$classes)
    )
  )
}

select_best <- function(records) {
  z <- copy(records)
  setorder(z, -MacroF1, LogLoss)
  z[, .SD[1], by = Model][order(-MacroF1)]
}

