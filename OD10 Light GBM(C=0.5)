# ------------------------------------------------------------
# 1. 直接由補值查找表建立 Y，不輸出大型旅次檔
# ------------------------------------------------------------

sites_model <- c(
  "VD_69p510_Speed",
  "VD_65p990_Speed",
  "VD_63p990_Speed",
  "VD_61p670_Speed"
)

w_model <- c(0.0417, 0.4600, 0.3600, 0.1383)

filled_cols <- paste0(sites_model, "_Filled")
method_cols <- paste0(sites_model, "_ImputationMethod")

stopifnot(all(
  c("__vd_key", filled_cols, method_cols) %in% names(lookup)
))

v <- as.matrix(lookup[, ..filled_cols])
m <- as.matrix(lookup[, ..method_cols])

valid_vd <- is.finite(v) & v >= 0

station_congested <- matrix(
  FALSE, nrow(v), ncol(v)
)
station_congested[valid_vd] <- v[valid_vd] < 40

coverage <- as.numeric(valid_vd %*% w_model)

C_model <- rep(NA_real_, nrow(v))
ok <- coverage > 0

C_model[ok] <- as.numeric(
  station_congested %*% w_model
)[ok] / coverage[ok]

C_model[ok] <- pmin(1, pmax(0, C_model[ok]))

imputed_flag <- matrix(
  m %in% c("LINEAR_SHORT", "KNN_2024"),
  nrow = nrow(m),
  ncol = ncol(m)
) & valid_vd

y_value <- rep(NA_integer_, length(C_model))
y_value[ok & C_model == 0] <- 0L
y_value[ok & C_model > 0 & C_model < 0.50] <- 1L
y_value[ok & C_model >= 0.50] <- 2L

y_model <- data.table(
  TimeKey = lookup[["__vd_key"]],
  Y = y_value,
  C_weighted = C_model,
  n_valid_vd = rowSums(valid_vd),
  Y_used_imputation = rowSums(imputed_flag) > 0
)

stopifnot(!anyDuplicated(y_model$TimeKey))

# ------------------------------------------------------------
# 2. 從補值後旅次檔彙總 OD／天氣
# 只載入彙總結果，不把四千多萬筆旅次全部載入 R
# ------------------------------------------------------------

prepared <- local({
  
  con_model <- DBI::dbConnect(duckdb::duckdb())
  
  on.exit(
    DBI::dbDisconnect(con_model, shutdown = TRUE)
  )
  
  qs_model <- function(x) {
    as.character(DBI::dbQuoteString(con_model, x))
  }
  
  DBI::dbExecute(con_model, "SET threads = 4")
  DBI::dbExecute(con_model, "SET memory_limit = '4GB'")
  
  DBI::dbExecute(
    con_model,
    paste0(
      "SET temp_directory = ",
      qs_model(file.path(model_dir, "duckdb_temp"))
    )
  )
  
  DBI::dbExecute(
    con_model,
    paste0(
      "CREATE VIEW src AS SELECT * FROM read_parquet(",
      qs_model(model_input_path), ")"
    )
  )
  
  sc <- DBI::dbGetQuery(con_model, "DESCRIBE src")
  
  time_type <- sc$column_type[
    sc$column_name == "BottleneckTime"
  ]
  
  stopifnot(length(time_type) == 1L)
  
  clock_source <- if (
    grepl("WITH TIME ZONE|TIMESTAMPTZ", time_type)
  ) {
    "timezone('UTC', BottleneckTime)"
  } else {
    "BottleneckTime"
  }
  
  # OD 的鐘面值按先前確認，不額外加 8 小時。
  # 這裡為旅次流量時間格，直接向下取整。
  clock_expr <- paste0(
    "TRY_CAST(REPLACE(SUBSTR(CAST(",
    clock_source,
    " AS VARCHAR),1,19),'T',' ') AS TIMESTAMP)"
  )
  
  DBI::dbExecute(
    con_model,
    paste0(
      "CREATE VIEW trips AS SELECT *, ",
      clock_expr, " AS ClockTime, ",
      "time_bucket(INTERVAL '5 minutes', ",
      clock_expr, ") AS TimeBin FROM src"
    )
  )
  
  where_2024 <- paste0(
    " WHERE ClockTime >= TIMESTAMP '2024-01-01'",
    " AND ClockTime < TIMESTAMP '2025-01-01' "
  )
  
  pairs <- as.data.table(DBI::dbGetQuery(
    con_model,
    paste0(
      "SELECT TimeBin, ",
      "CAST(GantryO AS VARCHAR) AS GantryO, ",
      "CAST(GantryD AS VARCHAR) AS GantryD, ",
      "COUNT(*) AS Trips FROM trips ",
      where_2024,
      " GROUP BY 1,2,3"
    )
  ))
  
  bins <- as.data.table(DBI::dbGetQuery(
    con_model,
    paste0(
      "SELECT TimeBin, COUNT(*) AS TotalTrips, ",
      "AVG(CASE WHEN isfinite(Weather_Temperature_C)",
      " THEN Weather_Temperature_C END) AS Temperature, ",
      "AVG(CASE WHEN isfinite(Weather_Dewpoint_C)",
      " THEN Weather_Dewpoint_C END) AS Dewpoint, ",
      "AVG(CASE WHEN isfinite(Weather_Precipitation_mm)",
      " THEN Weather_Precipitation_mm END) AS Precipitation, ",
      "AVG(CASE WHEN isfinite(Weather_WindSpeed_mps)",
      " THEN Weather_WindSpeed_mps END) AS WindSpeed ",
      "FROM trips ", where_2024,
      " GROUP BY 1"
    )
  ))
  
  calendar <- as.data.table(DBI::dbGetQuery(
    con_model,
    paste0(
      "SELECT CAST(ClockTime AS DATE) AS Date, ",
      "DayType, COUNT(*) AS Trips FROM trips ",
      where_2024,
      " GROUP BY 1,2"
    )
  ))
  
  calendar[, Date := as.Date(Date)]
  
  if (calendar[, .N, by = Date][N > 1L, .N] > 0L) {
    stop("同一天有不同 DayType，請先檢查日期分類。")
  }
  
  calendar <- calendar[, .(Date, DayType)]
  
  bins[, TimeKey := format(
    TimeBin, "%Y-%m-%d %H:%M:%S", tz = "UTC"
  )]
  
  bins[, Date := as.Date(substr(TimeKey, 1, 10))]
  
  pairs[, TimeKey := format(
    TimeBin, "%Y-%m-%d %H:%M:%S", tz = "UTC"
  )]
  
  pairs[, Date := as.Date(substr(TimeKey, 1, 10))]
  
  d <- merge(bins, y_model, by = "TimeKey", all.x = TRUE)
  d <- merge(d, calendar, by = "Date", all.x = TRUE)
  
  # 與剛才模型相同：只用四站完整原始實測 Y
  d <- d[
    DayType %in% c("WEEKEND", "LONGHOLIDAY") &
      !is.na(Y) &
      n_valid_vd == 4L &
      Y_used_imputation == FALSE
  ]
  
  setorder(d, TimeKey)
  
  if (!nrow(d)) stop("沒有符合條件的模型資料。")
  
  lt <- as.POSIXlt(
    d$TimeKey,
    format = "%Y-%m-%d %H:%M:%S",
    tz = "UTC"
  )
  
  hour_decimal <- lt$hour + lt$min / 60
  
  d[, `:=`(
    HourSin = sin(2 * pi * hour_decimal / 24),
    HourCos = cos(2 * pi * hour_decimal / 24),
    WeekSin = sin(2 * pi * lt$wday / 7),
    WeekCos = cos(2 * pi * lt$wday / 7),
    YearSin = sin(2 * pi * (lt$yday + 1) / 365.25),
    YearCos = cos(2 * pi * (lt$yday + 1) / 365.25),
    IsLongHoliday = as.integer(DayType == "LONGHOLIDAY")
  )]
  
  pairs <- merge(
    pairs, calendar, by = "Date", all.x = TRUE
  )
  
  pairs[, PairID := paste(
    GantryO, GantryD, sep = "__"
  )]
  
  list(data = d, pairs = pairs)
})

