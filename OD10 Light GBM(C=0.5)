# ------------------------------------------------------------
# 4. 每輪重新選 OD、建立各組歷史特徵
# ------------------------------------------------------------

for (f in seq_len(nrow(history_folds))) {
  
  z <- history_folds[f]
  
  run_name <- paste(
    history_tag, z$Fold, sep = "_"
  )
  
  # 沿用之前的特徵建構函數：
  # OD 排名只看該輪訓練期間
  bundle <- make_features(
    z$TrainEnd,
    z$ValidEnd,
    run_name
  )
  
  d <- bundle$data
  
  original_od10_features <- bundle$sets[["OD10"]]
  
  if (is.null(original_od10_features)) {
    stop("找不到 OD10 特徵。")
  }
  
  # make_features 會寫出本輪 OD 對照表
  map_path <- file.path(
    model_dir,
    paste0(run_name, "_OD_mapping.csv")
  )
  
  map <- fread(map_path)
  
  # 只取該輪訓練選出的前十個 OD
  map10 <- map[1:10, .(PairID, Feature)]
  
  # 完整時間格上的各組流量
  counts <- merge(
    history_pairs[, .(TimeKey, PairID, Trips)],
    map10,
    by = "PairID"
  )
  
  wide <- dcast(
    counts,
    TimeKey ~ Feature,
    value.var = "Trips",
    fun.aggregate = sum,
    fill = 0
  )
  
  od_history <- merge(
    history_grid,
    wide,
    by = "TimeKey",
    all.x = TRUE,
    sort = TRUE
  )
  
  # 有總旅次紀錄、但該 OD 沒出現：0
  # 完全沒有旅次紀錄的時間格：NA
  for (s in map10$Feature) {
    
    if (!s %in% names(od_history)) {
      od_history[, (s) := NA_real_]
    }
    
    set(
      od_history,
      which(
        od_history$HasTripRecord &
          is.na(od_history[[s]])
      ),
      s,
      0
    )
    
    set(
      od_history,
      which(!od_history$HasTripRecord),
      s,
      NA_real_
    )
  }
  
  od_source_columns <- c(
    map10$Feature, "OTHER_10"
  )
  
  od_history[
    ,
    OTHER_10 := TotalTrips -
      rowSums(as.matrix(.SD)),
    .SDcols = map10$Feature
  ]
  
  stopifnot(all(
    od_history$OTHER_10 >= 0 |
      is.na(od_history$OTHER_10)
  ))
  
  # 每時段分組流量應與既有 OD10 相符
  match_od <- match(
    d$TimeKey, od_history$TimeKey
  )
  
  stopifnot(!anyNA(match_od))
  
  for (s in od_source_columns) {
    if (!isTRUE(all.equal(
      as.numeric(d[[s]]),
      as.numeric(od_history[[s]][match_od]),
      check.attributes = FALSE
    ))) {
      stop(
        z$Fold, " 的當期 OD 特徵不一致：", s
      )
    }
  }
  
  od_history_features <- add_history(
    od_history,
    source_columns = od_source_columns,
    prefix = "Hist"
  )
  
  # 依時間鍵接回，不刪除或增加模型資料列
  match_total <- match(
    d$TimeKey, total_history$TimeKey
  )
  
  stopifnot(!anyNA(match_total))
  
  for (s in total_history_features) {
    set(
      d, j = s,
      value = total_history[[s]][match_total]
    )
  }
  
  for (s in od_history_features) {
    set(
      d, j = s,
      value = od_history[[s]][match_od]
    )
  }
  
  bundle$data <- d
  
  bundle$sets <- list(
    OD10 = original_od10_features,
    
    OD10_TotalHistory = c(
      original_od10_features,
      total_history_features
    ),
    
    OD10_ODHistory = c(
      original_od10_features,
      total_history_features,
      od_history_features
    )
  )
  
  # 缺失歷史特徵交由 LightGBM 處理，不額外刪樣本
  # 確保三方案使用完全相同的 Y 與時間格
  history_quality_list[[f]] <- data.table(
    Fold = z$Fold,
    TimeBins = nrow(d),
    AnyTotalHistoryMissing = sum(
      rowSums(is.na(
        as.matrix(d[, ..total_history_features])
      )) > 0
    ),
    AnyODHistoryMissing = sum(
      rowSums(is.na(
        as.matrix(d[, ..od_history_features])
      )) > 0
    )
  )
  
  # 保存本輪輸入，方便重現
  saveRDS(
    bundle,
    file.path(
      history_dir,
      paste0(z$Fold, "_feature_snapshot.rds")
    )
  )
  
  r <- run_grid(
    bundle,
    z$TrainEnd,
    z$ValidStart,
    z$ValidEnd,
    run_name,
    "SqrtBalanced"
  )
  
  # 保留簡短的 F1/F2/F3 輪次名稱
  r$records[, Fold := z$Fold]
  r$classes[, Fold := z$Fold]
  
  history_results_list[[f]] <- r$records
  history_classes_list[[f]] <- r$classes
}

