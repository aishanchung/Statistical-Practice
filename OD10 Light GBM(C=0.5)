# ------------------------------------------------------------
# 2. 產生只使用過去資訊的歷史特徵
# ------------------------------------------------------------

add_history <- function(dt, source_columns, prefix) {
  
  new_features <- character()
  
  for (s in source_columns) {
    
    x <- as.numeric(dt[[s]])
    
    lag1 <- shift(x, 1L)
    lag2 <- shift(x, 2L)
    
    # t 時點使用 t-1 至 t-3／t-6
    mean15 <- frollmean(
      lag1, n = 3L,
      align = "right", na.rm = FALSE
    )
    
    mean30 <- frollmean(
      lag1, n = 6L,
      align = "right", na.rm = FALSE
    )
    
    values <- list(
      Lag5 = lag1,
      Mean15 = mean15,
      Mean30 = mean30,
      Change5 = lag1 - lag2,
      Change15 = mean15 - shift(mean15, 3L)
    )
    
    for (suffix in names(values)) {
      
      feature_name <- paste(
        prefix, s, suffix, sep = "_"
      )
      
      set(
        dt,
        j = feature_name,
        value = values[[suffix]]
      )
      
      new_features <- c(
        new_features, feature_name
      )
    }
  }
  
  new_features
}

# 總量歷史只需建立一次
